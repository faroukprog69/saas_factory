{
  "name": "@faroukprog69/teams",
  "version": "0.0.1",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/@faroukprog69"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.mjs",
      "require": "./dist/schema.js"
    }
  },
  "scripts": {
    "dev": "tsup src/index.ts src/schema.ts --format cjs,esm --watch --dts --clean",
    "build": "tsup src/index.ts src/schema.ts --format cjs,esm --dts --clean --minify",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "crypto": "^1.0.1",
    "drizzle-orm": "^0.45.1",
    "nanoid": "^5.1.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "rimraf": "^5.0.5",
    "tsup": "^8.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.5.4"
  },
  "packageManager": "pnpm@10.4.1"
}
