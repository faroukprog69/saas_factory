{
  "name": "@faroukprog69/db",
  "version": "0.0.4",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/@faroukprog69"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsup src/index.ts --format cjs,esm --watch --dts --clean",
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --minify",
    "lint": "eslint . --max-warnings 0",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx src/seed.ts"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.1"
  },
  "dependencies": {
    "@faroukprog69/errors": "workspace:*",
    "@faroukprog69/types": "workspace:*",
    "@neondatabase/serverless": "^0.10.4",
    "dotenv": "^16.4.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.11",
    "@types/ws": "^8.5.10",
    "drizzle-kit": "^0.30.4",
    "drizzle-orm": "^0.45.1",
    "eslint": "^8.57.0",
    "rimraf": "^5.0.5",
    "tsup": "^8.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.5.4",
    "pg": "^8.13.1"
  },
  "packageManager": "pnpm@10.4.1"
}
